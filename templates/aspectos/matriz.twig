{% extends "layouts/app.twig" %}

{% block title %}{{ pageTitle }} - Tuqan{% endblock %}

{% block content %}
<div class="page-header" style="padding: 15px 20px; border-bottom: 1px solid #ddd; background: #fff;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 20px;">{{ pageTitle }}</h2>
        <div>
            <a href="/admin/aspectos" class="btn btn-default btn-sm">Vista de listado</a>
            <a href="/admin/aspectos/nuevo" class="btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-plus"></span> Nuevo Aspecto
            </a>
        </div>
    </div>
</div>

<div style="padding: 20px;">
    {% if aspectos is empty %}
        <div class="alert alert-info">No hay aspectos ambientales registrados.</div>
    {% else %}
        {% for area, items in grouped %}
        <h4 style="margin-top: 20px; border-bottom: 1px solid #eee; padding-bottom: 5px;">
            Área {{ area ?? 'Sin área' }} ({{ items|length }} aspectos)
        </h4>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Magnitud</th>
                        <th>Gravedad</th>
                        <th>Frecuencia</th>
                        <th>Impacto</th>
                        <th>Probabilidad</th>
                        <th>Severidad</th>
                        <th>Estado</th>
                        <th style="width:100px;text-align:right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for a in items %}
                    <tr>
                        <td>{{ a.id }}</td>
                        <td><strong>{{ a.nombre }}</strong></td>
                        <td>{{ a.tipo_aspecto ?? '-' }}</td>
                        <td>{{ a.magnitud ?? '-' }}</td>
                        <td>{{ a.gravedad ?? '-' }}</td>
                        <td>{{ a.frecuencia ?? '-' }}</td>
                        <td>{{ a.impacto ?? '-' }}</td>
                        <td>{{ a.probabilidad ?? '-' }}</td>
                        <td>{{ a.severidad ?? '-' }}</td>
                        <td>{% if a.activo %}<span class="label label-success">Activo</span>{% else %}<span class="label label-default">Inactivo</span>{% endif %}</td>
                        <td style="text-align:right;">
                            <a href="/admin/aspectos/editar/{{ a.id }}" class="btn btn-xs btn-default">Editar</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endfor %}
    {% endif %}

    <div class="alert alert-info" style="margin-top:15px;font-size:13px;">
        Aspectos — Matriz (Stage 9.14 first slice). Vista agrupada por área con los principales campos de evaluación.
        La matriz editable, revisiones, integración con cuestionarios y reporting a Indicadores se modernizarán en legs posteriores.
        Usa la vista de listado para CRUD básico.
    </div>
</div>
{% endblock %}