{% extends "layouts/app.twig" %}

{% block title %}Aspectos Ambientales - Tuqan{% endblock %}

{% block content %}
<div class="page-header" style="padding: 15px 20px; border-bottom: 1px solid #ddd; background: #fff;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 20px;">Aspectos Ambientales</h2>
        <div>
            <a href="/admin/aspectos/nuevo" class="btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-plus"></span> Nuevo Aspecto
            </a>
        </div>
    </div>
</div>

<div style="padding: 20px;">
    {% if aspectos is empty %}
        <div class="alert alert-info">No hay aspectos ambientales registrados.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Magnitud</th>
                        <th>Gravedad</th>
                        <th>Frecuencia</th>
                        <th>Área</th>
                        <th>Estado</th>
                        <th style="width:140px;text-align:right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for a in aspectos %}
                    <tr>
                        <td>{{ a.id }}</td>
                        <td><strong>{{ a.nombre }}</strong></td>
                        <td>{{ a.tipo_aspecto ?? '-' }}</td>
                        <td>{{ a.magnitud ?? '-' }}</td>
                        <td>{{ a.gravedad ?? '-' }}</td>
                        <td>{{ a.frecuencia ?? '-' }}</td>
                        <td>{{ a.area ?? '-' }}</td>
                        <td>{% if a.activo %}<span class="label label-success">Activo</span>{% else %}<span class="label label-default">Inactivo</span>{% endif %}</td>
                        <td style="text-align:right;">
                            <a href="/admin/aspectos/editar/{{ a.id }}" class="btn btn-xs btn-default">Editar</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
    <div class="alert alert-info" style="margin-top:15px;font-size:13px;">
        Aspectos Ambientales (Stage 9.7 basic shell). La matriz completa, revisiones, cuestionario y flujos de "Aspectos Ambientales Emergencia" se mantienen en legacy. La integración con Criterios y cálculos de significancia se modernizarán en legs posteriores.
    </div>
</div>
{% endblock %}