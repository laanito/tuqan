{% extends "layouts/app.twig" %}

{% block title %}Procesos - Tuqan{% endblock %}

{% block content %}
<div class="page-header" style="padding: 15px 20px; border-bottom: 1px solid #ddd; background: #fff;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 20px;">Procesos</h2>
        <div>
            <a href="/admin/procesos/nuevo" class="btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-plus"></span> Nuevo Proceso
            </a>
        </div>
    </div>
</div>

<div style="padding: 20px;">
    {% if procesos is empty %}
        <div class="alert alert-info">No hay procesos registrados.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Código</th>
                        <th>Revisión</th>
                        <th>Padre</th>
                        <th>Estado</th>
                        <th style="width:140px;text-align:right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in procesos %}
                    <tr>
                        <td>{{ p.id }}</td>
                        <td><strong>{{ p.nombre }}</strong></td>
                        <td>{{ p.codigo ?? '-' }}</td>
                        <td>{{ p.revision ?? '-' }}</td>
                        <td>{{ p.padre ?? 0 }}</td>
                        <td>{% if p.activo %}<span class="label label-success">Activo</span>{% else %}<span class="label label-default">Inactivo</span>{% endif %}</td>
                        <td style="text-align:right;">
                            <a href="/admin/procesos/editar/{{ p.id }}" class="btn btn-xs btn-default">Editar</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
    <div class="alert alert-info" style="margin-top:15px;font-size:13px;">
        Procesos (Stage 9.10 basic shell). El Árbol de Procesos, contenido detallado (contenido_procesos), flujogramas, indicadores de proceso, fichas y flujos de revisión/aprobación permanecen en legacy por ahora. Se modernizarán en legs posteriores.
    </div>
</div>
{% endblock %}