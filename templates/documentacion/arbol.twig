{% extends "layouts/app.twig" %}

{% block title %}{{ pageTitle }} - Tuqan{% endblock %}

{% block content %}
<div class="page-header" style="padding: 15px 20px; border-bottom: 1px solid #ddd; background: #fff;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 20px;">{{ pageTitle }}</h2>
        <div>
            <a href="/admin/documentacion" class="btn btn-default btn-sm">Vista de listado plano</a>
            <a href="/admin/documentacion/nuevo" class="btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-plus"></span> Nuevo Documento
            </a>
        </div>
    </div>
</div>

<div style="padding: 20px;">
    {% if documentos is empty %}
        <div class="alert alert-info">No hay documentos registrados.</div>
    {% else %}
        {% for tipo, docs in grouped %}
        <h4 style="margin-top:20px; border-bottom:1px solid #eee; padding-bottom:5px;">Tipo {{ tipo }} ({{ docs|length }} docs)</h4>
        <div class="table-responsive">
            <table class="table table-striped table-hover" style="margin-bottom:10px;">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre / Código</th>
                        <th>Revisión</th>
                        <th>Estado</th>
                        <th style="width:120px;text-align:right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for d in docs %}
                    <tr>
                        <td>{{ d.id }}</td>
                        <td><strong>{{ d.nombre }}</strong> <small class="text-muted">({{ d.codigo }})</small></td>
                        <td>{{ d.revision ?? '-' }}</td>
                        <td>{% if d.activo %}<span class="label label-success">Activo</span>{% else %}<span class="label label-default">Inactivo</span>{% endif %}</td>
                        <td style="text-align:right;">
                            <a href="/admin/documentacion/editar/{{ d.id }}" class="btn btn-xs btn-default">Editar</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endfor %}
    {% endif %}

    <div class="alert alert-info" style="margin-top:15px;font-size:13px;">
        Documentación — Árbol / tree view shell (Stage 9.12). Agrupado por tipo_documento como primera aproximación al árbol de documentos.
        El árbol completo (arbol_documentos.php), editor, arrays de perfiles, flujos de aprobación y exports PDF permanecen en legacy.
        Usa la vista plano para el listado básico.
    </div>
</div>
{% endblock %}