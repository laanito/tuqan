{% extends "layouts/app.twig" %}

{% block title %}{{ pageTitle }} - Tuqan{% endblock %}

{% block content %}
<div class="page-header" style="padding: 15px 20px; border-bottom: 1px solid #ddd; background: #fff;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 20px;">{{ pageTitle }}</h2>
        <div>
            <a href="/admin/documentacion" class="btn btn-default btn-sm">Volver al listado</a>
        </div>
    </div>
</div>

<div style="padding: 20px; max-width: 700px;">
    <form method="POST" action="{{ isEdit ? '/admin/documentacion/editar/' ~ documento.id : '/admin/documentacion/nuevo' }}">
        {% if isEdit %}
            <input type="hidden" name="id" value="{{ documento.id }}">
        {% endif %}

        <div class="form-group">
            <label for="nombre">Nombre</label>
            <input type="text" class="form-control" id="nombre" name="nombre"
                   value="{{ documento.nombre ?? '' }}" required>
        </div>

        <div class="form-group">
            <label for="codigo">Código</label>
            <input type="text" class="form-control" id="codigo" name="codigo"
                   value="{{ documento.codigo ?? '' }}">
        </div>

        <div class="form-group">
            <label for="contenido">Contenido (texto)</label>
            <textarea class="form-control" id="contenido" name="contenido" rows="8">{{ documento.contenido ?? '' }}</textarea>
        </div>

        {% if isEdit and documento.estado is not null %}
        <div class="form-group">
            <label>Estado actual</label>
            <div>
                <span class="label {{ documento.estado_badge|default('label-default') }}" style="font-size:14px;padding:4px 10px;">
                    {{ documento.estado_label ?? documento.estado }}
                </span>
            </div>
        </div>
        {% endif %}

        <div class="form-group">
            <label for="estado">Estado</label>
            <select class="form-control" id="estado" name="estado">
                <option value="">-- Seleccionar --</option>
                {% for e in estado_options %}
                    <option value="{{ e.id }}" {% if e.id == documento.estado %}selected{% endif %}>{{ e.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="revision">Revisión</label>
            <input type="text" class="form-control" id="revision" name="revision"
                   value="{{ documento.revision ?? '' }}">
        </div>

        <div class="form-group">
            <label for="tipo_documento">Tipo Documento</label>
            <select class="form-control" id="tipo_documento" name="tipo_documento">
                <option value="">-- Seleccionar --</option>
                {% for t in tipo_documento_options %}
                    <option value="{{ t.id }}" {% if t.id == documento.tipo_documento %}selected{% endif %}>{{ t.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="area">Área</label>
            <select class="form-control" id="area" name="area">
                <option value="">-- Seleccionar --</option>
                {% for a in area_options %}
                    <option value="{{ a.id }}" {% if a.id == documento.area %}selected{% endif %}>{{ a.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label>Perfiles</label>
            <div class="checkbox">
                <label><input type="checkbox" name="perfil_ver" value="1" {% if not isEdit or documento.perfil_ver %}checked{% endif %}> Ver</label>
            </div>
            <div class="checkbox">
                <label><input type="checkbox" name="perfil_nueva" value="1" {% if not isEdit or documento.perfil_nueva %}checked{% endif %}> Nueva</label>
            </div>
            <div class="checkbox">
                <label><input type="checkbox" name="perfil_modificar" value="1" {% if not isEdit or documento.perfil_modificar %}checked{% endif %}> Modificar</label>
            </div>
            <div class="checkbox">
                <label><input type="checkbox" name="perfil_revisar" value="1" {% if not isEdit or documento.perfil_revisar %}checked{% endif %}> Revisar</label>
            </div>
            <div class="checkbox">
                <label><input type="checkbox" name="perfil_aprobar" value="1" {% if not isEdit or documento.perfil_aprobar %}checked{% endif %}> Aprobar</label>
            </div>
            <div class="checkbox">
                <label><input type="checkbox" name="perfil_historico" value="1" {% if not isEdit or documento.perfil_historico %}checked{% endif %}> Histórico</label>
            </div>
            <div class="checkbox">
                <label><input type="checkbox" name="perfil_tareas" value="1" {% if not isEdit or documento.perfil_tareas %}checked{% endif %}> Tareas</label>
            </div>
        </div>

        <div class="form-group">
            <label for="revisado_por">Revisado por</label>
            <select class="form-control" id="revisado_por" name="revisado_por">
                <option value="">-- Ninguno --</option>
                {% for u in usuario_options %}
                    <option value="{{ u.id }}" {% if u.id == documento.revisado_por %}selected{% endif %}>{{ u.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="aprobado_por">Aprobado por</label>
            <select class="form-control" id="aprobado_por" name="aprobado_por">
                <option value="">-- Ninguno --</option>
                {% for u in usuario_options %}
                    <option value="{{ u.id }}" {% if u.id == documento.aprobado_por %}selected{% endif %}>{{ u.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="fecha_revision">Fecha Revisión</label>
            <input type="date" class="form-control" id="fecha_revision" name="fecha_revision"
                   value="{{ documento.fecha_revision ?? '' }}">
        </div>

        <div class="form-group">
            <label for="fecha_aprobacion">Fecha Aprobación</label>
            <input type="date" class="form-control" id="fecha_aprobacion" name="fecha_aprobacion"
                   value="{{ documento.fecha_aprobacion ?? '' }}">
        </div>

        <div class="form-group">
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="activo" value="1"
                           {% if not isEdit or documento.activo %}checked{% endif %}>
                    Activo
                </label>
            </div>
        </div>

        <div class="form-group">
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="calidad" value="1"
                           {% if not isEdit or documento.calidad %}checked{% endif %}>
                    Calidad
                </label>
            </div>
        </div>

        <div class="form-group">
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="medioambiente" value="1"
                           {% if not isEdit or documento.medioambiente %}checked{% endif %}>
                    Medio Ambiente
                </label>
            </div>
        </div>

        <div class="form-group" style="margin-top: 20px;">
            <button type="submit" class="btn btn-primary">
                {{ isEdit ? 'Guardar cambios' : 'Crear Documento' }}
            </button>
            <a href="/admin/documentacion" class="btn btn-default" style="margin-left: 8px;">Cancelar</a>
        </div>

        <div class="alert alert-info" style="margin-top: 20px; font-size: 13px;">
            Documentación (9.5–9.26 + 9.31). Estado con etiquetas (En vigor / Borrador / …). Rich editor / binario deferred.
        </div>
    </form>
</div>
{% endblock %}