{% extends "layouts/app.twig" %}

{% block title %}Menús - Tuqan{% endblock %}

{% block content %}
<div class="page-header" style="padding: 15px 20px; border-bottom: 1px solid #ddd; background: #fff;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 20px;">Menús (Estructura y Traducciones)</h2>
    </div>
</div>

<div style="padding: 20px;">
    <form method="POST" action="/admin/menus">
        <p class="text-muted">Edición básica de orden y etiqueta en español (para los menús bajo Aplicación u otros). Guarda todos los cambios con un solo botón.</p>

        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Padre</th>
                        <th style="width:80px;">Orden</th>
                        <th>Etiqueta (ES)</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    {% for m in menus %}
                    <tr>
                        <td>{{ m.id }}</td>
                        <td>{{ m.padre ?? '—' }}</td>
                        <td>
                            <input type="text" name="orden[{{ m.id }}]" value="{{ m.orden }}" size="4" class="form-control input-sm">
                        </td>
                        <td>
                            <input type="text" name="label_es[{{ m.id }}]" value="{{ m.label_es ?? '' }}" class="form-control input-sm" style="min-width:220px;">
                        </td>
                        <td><code style="font-size: 11px;">{{ m.accion ?? '' }}</code></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <button type="submit" class="btn btn-primary">Guardar cambios de orden y etiquetas</button>
        <a href="/admin/menus" class="btn btn-default">Recargar</a>
    </form>

    <div class="alert alert-info" style="margin-top:15px;">
        Solo los menús listados arriba son editables aquí. Orden y traducciones se guardan en <code>menu_nuevo</code> + <code>menu_idiomas_nuevo</code>.
    </div>
</div>
{% endblock %}