{% extends "layouts/app.twig" %}

{% block title %}Clientes - Tuqan{% endblock %}

{% block content %}
<div class="page-header" style="padding: 15px 20px; border-bottom: 1px solid #ddd; background: #fff;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 20px;">Clientes</h2>
        <div>
            <a href="/admin/clientes/nuevo" class="btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-plus"></span> Nuevo Cliente
            </a>
        </div>
    </div>
</div>

<div style="padding: 20px;">
    {% if clientes is empty %}
        <div class="alert alert-info">No hay clientes registrados.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr><th>ID</th><th>Nombre</th><th>Estado</th><th style="width:140px;text-align:right;">Acciones</th></tr>
                </thead>
                <tbody>
                    {% for c in clientes %}
                    <tr>
                        <td>{{ c.id }}</td>
                        <td><strong>{{ c.nombre }}</strong></td>
                        <td>{% if c.activo %}<span class="label label-success">Activo</span>{% else %}<span class="label label-default">Inactivo</span>{% endif %}</td>
                        <td style="text-align:right;">
                            <a href="/admin/clientes/editar/{{ c.id }}" class="btn btn-xs btn-default">Editar</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
    <div class="alert alert-info" style="margin-top:15px;font-size:13px;">
        Clientes es el primer módulo completo implementado bajo <strong>Personalizacion</strong> (Stage 8.6). Más módulos de este grupo se agregarán de forma incremental.
    </div>
</div>
{% endblock %}