{% extends "layouts/app.twig" %}

{% block title %}{{ pageTitle }} - Tuqan{% endblock %}

{% block content %}
<div class="page-header" style="padding: 15px 20px; border-bottom: 1px solid #ddd; background: #fff;">
    <h2 style="margin: 0; font-size: 20px;">{{ pageTitle }}</h2>
    <div style="margin-top:8px;">
        <a href="/admin/permisos" class="btn btn-default btn-sm">Volver al listado de perfiles</a>
    </div>
</div>

<div style="padding: 20px;">
    <form method="POST" action="/admin/permisos/editar/{{ perfilId }}">
        <p class="text-muted">Marca los menús que este perfil puede ver. Se actualiza la columna <code>permisos</code> del menú (array legacy).</p>

        <table class="table table-striped" style="max-width: 700px;">
            <thead>
                <tr>
                    <th>Menú</th>
                    <th>Acción</th>
                    <th style="width:80px;">Permitido</th>
                </tr>
            </thead>
            <tbody>
            {% for m in menus %}
                <tr>
                    <td>{{ m.label }}</td>
                    <td><small class="text-muted">{{ m.accion }}</small></td>
                    <td>
                        <input type="checkbox" name="allowed[]" value="{{ m.id }}" {% if m.can %}checked{% endif %}>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">Guardar permisos para este perfil</button>
        <a href="/admin/permisos" class="btn btn-default">Cancelar</a>
    </form>

    <div class="alert alert-warning" style="margin-top:20px;max-width:700px;">
        <strong>Nota:</strong> Esto es una implementación básica de la matriz. Solo afecta a los menús cargados. El array de permisos se reconstruye por posición de perfil.
    </div>
</div>
{% endblock %}