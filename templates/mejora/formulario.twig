{% extends "layouts/app.twig" %}

{% block title %}{{ pageTitle }} - Tuqan{% endblock %}

{% block content %}
<div class="page-header" style="padding: 15px 20px; border-bottom: 1px solid #ddd; background: #fff;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 20px;">{{ pageTitle }}</h2>
        <div>
            <a href="/admin/mejora" class="btn btn-default btn-sm">Volver al listado</a>
        </div>
    </div>
</div>

<div style="padding: 20px; max-width: 780px;">
    <form method="POST" action="{{ isEdit ? '/admin/mejora/editar/' ~ mejora.id : '/admin/mejora/nuevo' }}">
        {% if isEdit %}
            <input type="hidden" name="id" value="{{ mejora.id }}">
        {% endif %}

        {% if isEdit %}
        <div class="form-group" style="margin-bottom: 15px;">
            <label>Estado actual</label>
            <div>
                {% set estado = 'Pendiente' %}
                {% if mejora.cerrada %}
                    {% set estado = 'Cerrada' %}
                {% elseif mejora.usuario_verifica %}
                    {% set estado = 'Verificada' %}
                {% endif %}
                {% if estado == 'Cerrada' %}
                    <span class="label label-success" style="font-size:14px; padding:4px 10px;">Cerrada</span>
                {% elseif estado == 'Verificada' %}
                    <span class="label label-info" style="font-size:14px; padding:4px 10px;">Verificada</span>
                {% else %}
                    <span class="label label-default" style="font-size:14px; padding:4px 10px;">Pendiente</span>
                {% endif %}
            </div>
        </div>
        {% endif %}

        <div class="form-group">
            <label for="fecha">Fecha</label>
            <input type="date" class="form-control" id="fecha" name="fecha"
                   value="{{ mejora.fecha ?? '' }}" required>
        </div>

        <div class="form-group">
            <label for="tipo">Tipo</label>
            <select class="form-control" id="tipo" name="tipo">
                <option value="">-- Seleccionar --</option>
                {% for t in tipo_options %}
                    <option value="{{ t.id }}" {% if t.id == mejora.tipo %}selected{% endif %}>{{ t.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="cliente">Cliente</label>
            <select class="form-control" id="cliente" name="cliente">
                <option value="">-- Ninguno --</option>
                {% for c in cliente_options %}
                    <option value="{{ c.id }}" {% if c.id == mejora.cliente %}selected{% endif %}>{{ c.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="usuario_detectado">Detectado por</label>
            <select class="form-control" id="usuario_detectado" name="usuario_detectado">
                <option value="">-- Ninguno --</option>
                {% for u in usuario_options %}
                    <option value="{{ u.id }}" {% if u.id == mejora.usuario_detectado %}selected{% endif %}>{{ u.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="usuario_cerrado">Cerrada por</label>
            <select class="form-control" id="usuario_cerrado" name="usuario_cerrado">
                <option value="">-- Ninguno --</option>
                {% for u in usuario_options %}
                    <option value="{{ u.id }}" {% if u.id == mejora.usuario_cerrado %}selected{% endif %}>{{ u.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="auditoria">Auditoría</label>
            <select class="form-control" id="auditoria" name="auditoria">
                <option value="">-- Ninguna --</option>
                {% for a in auditoria_options %}
                    <option value="{{ a.id }}" {% if a.id == mejora.auditoria %}selected{% endif %}>{{ a.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="usuario_verifica">Verifica</label>
            <select class="form-control" id="usuario_verifica" name="usuario_verifica">
                <option value="">-- Ninguno --</option>
                {% for u in usuario_options %}
                    <option value="{{ u.id }}" {% if u.id == mejora.usuario_verifica %}selected{% endif %}>{{ u.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="fecha_verifica">Fecha Verifica</label>
            <input type="date" class="form-control" id="fecha_verifica" name="fecha_verifica"
                   value="{{ mejora.fecha_verifica ?? '' }}">
        </div>

        <div class="form-group">
            <label for="usuario_implantacion">Implantado por</label>
            <select class="form-control" id="usuario_implantacion" name="usuario_implantacion">
                <option value="">-- Ninguno --</option>
                {% for u in usuario_options %}
                    <option value="{{ u.id }}" {% if u.id == mejora.usuario_implantacion %}selected{% endif %}>{{ u.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="fecha_cierre">Fecha Cierre</label>
            <input type="date" class="form-control" id="fecha_cierre" name="fecha_cierre"
                   value="{{ mejora.fecha_cierre ?? '' }}">
        </div>

        <div class="form-group">
            <label>Acciones de workflow (auto-asigna usuario actual + fecha de hoy si no se especifica)</label>
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="accion_verificar" value="1">
                    Marcar como verificada ahora
                </label>
            </div>
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="accion_cerrar" value="1">
                    Cerrar acción ahora (requiere verificada)
                </label>
            </div>
        </div>

        <div class="form-group">
            <label for="descripcion">Descripción</label>
            <input type="text" class="form-control" id="descripcion" name="descripcion"
                   value="{{ mejora.descripcion ?? '' }}" required>
        </div>

        <div class="form-group">
            <label for="analisis">Análisis</label>
            <textarea class="form-control" id="analisis" name="analisis" rows="2">{{ mejora.analisis ?? '' }}</textarea>
        </div>

        <div class="form-group">
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="requiere_tratamiento" value="1"
                           {% if not isEdit or mejora.requiere_tratamiento %}checked{% endif %}>
                    Requiere tratamiento
                </label>
            </div>
        </div>

        <div class="form-group">
            <label for="tratamiento">Tratamiento</label>
            <textarea class="form-control" id="tratamiento" name="tratamiento" rows="2">{{ mejora.tratamiento ?? '' }}</textarea>
        </div>

        <div class="form-group">
            <label for="accion_preventiva">Acción preventiva</label>
            <textarea class="form-control" id="accion_preventiva" name="accion_preventiva" rows="2">{{ mejora.accion_preventiva ?? '' }}</textarea>
        </div>

        <div class="form-group">
            <label for="fecha_implantacion">Fecha implantación</label>
            <input type="date" class="form-control" id="fecha_implantacion" name="fecha_implantacion"
                   value="{{ mejora.fecha_implantacion ?? '' }}">
        </div>

        <div class="form-group">
            <label for="plazo">Plazo</label>
            <input type="date" class="form-control" id="plazo" name="plazo"
                   value="{{ mejora.plazo ?? '' }}">
        </div>

        <div class="form-group">
            <label for="coste">Coste</label>
            <input type="number" step="0.01" class="form-control" id="coste" name="coste"
                   value="{{ mejora.coste ?? '' }}">
        </div>

        <div class="form-group">
            <label for="area">Área</label>
            <input type="text" class="form-control" id="area" name="area"
                   value="{{ mejora.area ?? '' }}">
        </div>

        <div class="form-group">
            <label for="observaciones">Observaciones</label>
            <textarea class="form-control" id="observaciones" name="observaciones" rows="2">{{ mejora.observaciones ?? '' }}</textarea>
        </div>

        <div class="form-group">
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="cerrada" value="1"
                           {% if mejora.cerrada %}checked{% endif %}>
                    Cerrada
                </label>
            </div>
        </div>

        <div class="form-group" style="margin-top: 20px;">
            <button type="submit" class="btn btn-primary">
                {{ isEdit ? 'Guardar cambios' : 'Crear Acción' }}
            </button>
            <a href="/admin/mejora" class="btn btn-default" style="margin-left: 8px;">Cancelar</a>
        </div>

        <div class="alert alert-info" style="margin-top: 20px; font-size: 13px;">
            Acciones de Mejora (Stage 9.4 + 9.17 + 9.21 + 9.25 + 9.27 + 9.28). Full state machine: auto user/date on transitions, quick verify/cerrar buttons, estado display.
        </div>
    </form>
</div>
{% endblock %}