{% extends "layouts/app.twig" %}

{% block title %}{{ pageTitle }} - Tuqan{% endblock %}

{% block content %}
<div class="page-header" style="padding: 15px 20px; border-bottom: 1px solid #ddd; background: #fff;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 20px;">{{ pageTitle }}</h2>
        <div>
            <a href="/admin/auditorias" class="btn btn-default btn-sm">Volver al listado</a>
        </div>
    </div>
</div>

<div style="padding: 20px; max-width: 700px;">
    <form method="POST" action="{{ isEdit ? '/admin/auditorias/editar/' ~ auditorias.id : '/admin/auditorias/nuevo' }}">
        {% if isEdit %}
            <input type="hidden" name="id" value="{{ auditorias.id }}">
        {% endif %}

        <div class="form-group">
            <label for="nombre">Nombre</label>
            <input type="text" class="form-control" id="nombre" name="nombre"
                   value="{{ auditorias.nombre ?? '' }}" required>
        </div>

        <div class="form-group">
            <label for="revision">Revisión</label>
            <input type="text" class="form-control" id="revision" name="revision"
                   value="{{ auditorias.revision ?? '' }}" placeholder="Rev 01">
        </div>

        <div class="form-group">
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="vigente" value="1"
                           {% if not isEdit or auditorias.vigente %}checked{% endif %}>
                    Vigente
                </label>
            </div>
        </div>

        <div class="form-group">
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="activo" value="1"
                           {% if not isEdit or auditorias.activo %}checked{% endif %}>
                    Activo
                </label>
            </div>
        </div>

        <div class="form-group" style="margin-top: 20px;">
            <button type="submit" class="btn btn-primary">
                {{ isEdit ? 'Guardar cambios' : 'Crear Programa' }}
            </button>
            <a href="/admin/auditorias" class="btn btn-default" style="margin-left: 8px;">Cancelar</a>
        </div>

        <div class="alert alert-info" style="margin-top: 20px; font-size: 13px;">
            Auditorías - Programa (Stage 9.6). Ejecución de auditorías, planes, horarios, equipo, hallazgos e informes se añadirán en legs posteriores. Acciones de mejora vinculadas a auditorías se gestionan actualmente vía Mejora.
        </div>
    </form>
</div>
{% endblock %}