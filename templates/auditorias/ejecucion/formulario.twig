{% extends "layouts/app.twig" %}

{% block title %}{{ pageTitle }} - Tuqan{% endblock %}

{% block content %}
<div class="page-header" style="padding: 15px 20px; border-bottom: 1px solid #ddd; background: #fff;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 20px;">{{ pageTitle }}</h2>
        <div>
            <a href="/admin/auditorias/ejecucion" class="btn btn-default btn-sm">Volver al listado</a>
        </div>
    </div>
</div>

<div style="padding: 20px; max-width: 780px;">
    <form method="POST" action="{{ isEdit ? '/admin/auditorias/ejecucion/editar/' ~ auditoria.id : '/admin/auditorias/ejecucion/nuevo' }}">
        {% if isEdit %}
            <input type="hidden" name="id" value="{{ auditoria.id }}">
        {% endif %}

        <div class="form-group">
            <label for="nombre">Nombre</label>
            <input type="text" class="form-control" id="nombre" name="nombre"
                   value="{{ auditoria.nombre ?? '' }}" required>
        </div>

        <div class="form-group">
            <label for="programa">Programa</label>
            <select class="form-control" id="programa" name="programa">
                <option value="">-- Seleccionar --</option>
                {% for p in programa_options %}
                    <option value="{{ p.id }}" {% if p.id == auditoria.programa %}selected{% endif %}>{{ p.nombre }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="fecha">Fecha</label>
            <input type="date" class="form-control" id="fecha" name="fecha"
                   value="{{ auditoria.fecha ?? '' }}">
        </div>

        <div class="form-group">
            <label for="estado">Estado</label>
            <input type="number" class="form-control" id="estado" name="estado"
                   value="{{ auditoria.estado ?? 0 }}">
        </div>

        <div class="form-group">
            <label for="descripcion">Descripción</label>
            <textarea class="form-control" id="descripcion" name="descripcion" rows="2">{{ auditoria.descripcion ?? '' }}</textarea>
        </div>

        <div class="form-group">
            <div class="checkbox">
                <label>
                    <input type="checkbox" name="activo" value="1"
                           {% if not isEdit or auditoria.activo %}checked{% endif %}>
                    Activo
                </label>
            </div>
        </div>

        <div class="form-group" style="margin-top: 20px;">
            <button type="submit" class="btn btn-primary">
                {{ isEdit ? 'Guardar cambios' : 'Crear Auditoría' }}
            </button>
            <a href="/admin/auditorias/ejecucion" class="btn btn-default" style="margin-left: 8px;">Cancelar</a>
        </div>

        <div class="alert alert-info" style="margin-top: 20px; font-size: 13px;">
            Auditorías ejecución (Stage 9.19 first slice). Campos avanzados (plan, horario, hallazgos, informes) y enlaces a Mejora diferidos.
        </div>
    </form>
</div>
{% endblock %}