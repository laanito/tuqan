{% extends "layouts/app.twig" %}

{% block title %}Indicadores - Tuqan{% endblock %}

{% block content %}
<div class="page-header" style="padding: 15px 20px; border-bottom: 1px solid #ddd; background: #fff;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-size: 20px;">Indicadores</h2>
        <div>
            <a href="/admin/indicadores/nuevo" class="btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-plus"></span> Nuevo Indicador
            </a>
        </div>
    </div>
</div>

<div style="padding: 20px;">
    {% if indicadores is empty %}
        <div class="alert alert-info">No hay indicadores registrados.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Definición</th>
                        <th>Valor Objetivo</th>
                        <th>Valor Tolerable</th>
                        <th>Genera Objetivo</th>
                        <th>Estado</th>
                        <th style="width:140px;text-align:right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for i in indicadores %}
                    <tr>
                        <td>{{ i.id }}</td>
                        <td><strong>{{ i.nombre }}</strong></td>
                        <td>{{ i.definicion ?? '-' }}</td>
                        <td>{{ i.valor_objetivo ?? '-' }}</td>
                        <td>{{ i.valor_tolerable ?? '-' }}</td>
                        <td>{% if i.genera_objetivo %}<span class="label label-info">Sí</span>{% else %}-{% endif %}</td>
                        <td>{% if i.activo %}<span class="label label-success">Activo</span>{% else %}<span class="label label-default">Inactivo</span>{% endif %}</td>
                        <td style="text-align:right;">
                            <a href="/admin/indicadores/editar/{{ i.id }}" class="btn btn-xs btn-default">Editar</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
    <div class="alert alert-info" style="margin-top:15px;font-size:13px;">
        Indicadores (Stage 9.9 basic). Gráficos, cálculos automáticos, metas, objetivos y dashboard se gestionan actualmente en legacy. La integración completa con otros módulos se añadirá en legs posteriores.
    </div>
</div>
{% endblock %}