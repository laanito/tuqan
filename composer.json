{
  "name": "praderas/tuqan",
  "description": "Quality Management app",
  "minimum-stability": "beta",
  "license": "MIT",
  "authors": [
    {
      "name": "Luis Amigo",
      "email": "lamigo@praderas.org"
    }
  ],
  "require": {
    "setasign/fpdf": "1.8.1",
    "phroute/phroute": "v2.1.0",
    "jasny/auth": "v1.0.1",
    "twig/twig": "~1.35",
    "monolog/monolog": "~1.23",
    "ext-gettext": "*",
    "anahkiasen/former": "4.1.7",
    "ext-pdo_pgsql": "*",
    "ext-pdo": "*",
    "ext-gd": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11"
  },
  "config": {
    "audit": {
      "ignore": ["*"],
      "block-insecure": false
    },
    "allow-plugins": {
      "kylekatarnls/update-helper": true
    },
    "platform": {
      "php": "8.2.0"
    }
  },
  "autoload": {
    "psr-4": {
      "Tuqan\\Classes\\": "Classes/",
      "Tuqan\\Controllers\\": "Controllers/",
      "Tuqan\\Pages\\": "Pages/"
    }
  },
  "autoload": {
    "psr-4": {
      "Tuqan\\Classes\\": "Classes/",
      "Tuqan\\Controllers\\": "Controllers/",
      "Tuqan\\Pages\\": "Pages/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tuqan\\Tests\\": "tests/"
    }
  }
}
